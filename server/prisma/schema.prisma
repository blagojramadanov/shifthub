// Prisma schema: the single source of truth for the database structure.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7+), not here.
datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGER
  EMPLOYEE
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique // always stored lowercase
  name         String?
  // bcrypt hash of the password, never the password itself. Never return it from the API.
  passwordHash String
  role         Role     @default(EMPLOYEE)
  createdAt    DateTime @default(now())
  shifts       Shift[]
}

model Shift {
  id         String   @id @default(uuid())
  title      String
  startTime  DateTime
  endTime    DateTime
  position   String?
  notes      String?
  employeeId Int?
  employee   User?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([startTime])
  @@index([employeeId])
}
