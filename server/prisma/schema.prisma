// Prisma schema: the single source of truth for the database structure.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7+), not here.
datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  shifts    Shift[]
}

model Shift {
  id         String   @id @default(uuid())
  title      String
  startTime  DateTime
  endTime    DateTime
  position   String?
  notes      String?
  employeeId Int?
  employee   User?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([startTime])
  @@index([employeeId])
}
