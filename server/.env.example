# Copy this file to .env and adjust values as needed.
PORT=3000

# "production" hides error details (stack traces) from API responses.
NODE_ENV=development

# Origin of the frontend allowed by CORS (no trailing slash).
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string (e.g. Neon pooled URL). Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Optional: direct (non-pooled) URL used only by Prisma migrations.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"

# Secret for signing login tokens (JWT). At least 32 random characters.
# Use a different value on Render. Changing it logs everyone out.
JWT_SECRET=replace-with-at-least-32-random-characters

# How long a login token is valid: a number plus s, m, h or d. Default: 1d.
JWT_EXPIRES_IN=1d
